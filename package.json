{
    "name": "match-studio-viewer",
    "version": "2.0.0",
    "private": false,
    "description": "Nova 实时雷达：浏览器端对局实时态势查看（2D 态势图 + 可选 3D 场景），仅实时，不含回放与导播",
    "type": "module",
    "scripts": {
        "dev": "node dev/server.mjs",
        "start": "node dev/server.mjs",
        "test": "node --test dev/*.test.mjs",
        "check:states": "node dev/states-smoke.mjs",
        "check:live": "node dev/live-check.mjs",
    "check:fpv": "node dev/fpv-check.mjs"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/thexin7/match-studio-viewer.git"
    },
    "keywords": [
        "live",
        "radar",
        "tactical-map",
        "leaflet",
        "threejs"
    ],
    "devDependencies": {
        "gltf-validator": "2.0.0-dev.3.10",
        "meshoptimizer": "1.3.0"
    }
}
